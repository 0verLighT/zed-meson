{
  "executable": {
    "prefix": "!executable",
    "body": [
      "project(",
      "  '${1:project_name}',",
      "  ['${2:language}'],",
      "  license : '${3:MIT}',",
      "  meson_version: '>=${4:0.63.0}',",
      "  version : '0.0.1',",
      "  default_options : [${5:'warning_level=2'}]",
      ")",
      "",
      "sources = files(",
      "  '${6:main.$2}',",
      ")",
      "",
      "inc = include_directories('${7:include}')",
      "",
      "deps = [${8}]",
      "",
      "executable(",
      "  '$1',",
      "  sources,",
      "  include_directories : inc,",
      "  dependencies : deps,",
      "  install: true,",
      ")",
      "$0"
    ],
    "description": "Basic structure of a meson.build executable",
  },
  "libary": {
    "prefix": "!libary",
    "body": [
      "project(",
      "  '${1:project_name}',",
      "  ['${2:language}'],",
      "  license : '${3:MIT}',",
      "  meson_version: '>=${4:0.63.0}',",
      "  version : '0.0.1',",
      "  default_options : [${5:'warning_level=2'}]",
      ")",
      "",
      "sources = files(",
      "  '${6:main.$2}',",
      ")",
      "",
      "inc = include_directories('${7:include}')",
      "",
      "deps = [${8}]",
      "",
      "library(",
      "  '$1',",
      "  sources,",
      "  include_directories : inc,",
      "  dependencies : deps,",
      "  install: true,",
      ")",
      "$0"
    ],
    "description": "Basic structure of a meson.build library",
  }
}
